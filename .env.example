# ============================================================
# Vendas + IA — configuração do provedor de LLM
# Copie este arquivo para ".env" e preencha as variáveis.
# ============================================================

# ----------------------------------------------------------
# PROVEDOR (obrigatório)
# Opções: groq | openai | openrouter | gemini | anthropic |
#         mistral | deepseek | together | ollama | lmstudio | custom
# ----------------------------------------------------------
LLM_PROVIDER=groq

# ----------------------------------------------------------
# MODELO (obrigatório para a maioria dos provedores)
# Exemplos por provedor:
#   groq        → llama-3.3-70b-versatile | llama-3.1-8b-instant | mixtral-8x7b-32768
#   openai      → gpt-4o | gpt-4o-mini | gpt-4-turbo
#   openrouter  → openai/gpt-4o | google/gemini-flash-1.5 | meta-llama/llama-3.3-70b-instruct
#   gemini      → gemini-2.0-flash | gemini-1.5-pro | gemini-1.5-flash
#   anthropic   → claude-3-5-sonnet-20241022 | claude-3-haiku-20240307
#   mistral     → mistral-large-latest | mistral-small-latest
#   deepseek    → deepseek-chat | deepseek-reasoner
#   together    → meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo
#   ollama      → llama3.3 | qwen2.5 | gemma3  (precisa estar rodando localmente)
#   lmstudio    → (use o nome do modelo carregado no LM Studio)
# ----------------------------------------------------------
LLM_MODEL=llama-3.3-70b-versatile

# Modelos de fallback (opcional, separados por vírgula)
# LLM_FALLBACK_MODELS=llama-3.1-8b-instant,mixtral-8x7b-32768

# ----------------------------------------------------------
# CHAVE DE API (obrigatório para provedores em nuvem)
# Use LLM_API_KEY para qualquer provedor (alternativa genérica),
# ou a variável específica do provedor (ambas funcionam):
#   GROQ_API_KEY       → https://console.groq.com/keys
#   OPENAI_API_KEY     → https://platform.openai.com/api-keys
#   OPENROUTER_API_KEY → https://openrouter.ai/keys
#   GEMINI_API_KEY     → https://aistudio.google.com/apikey
#   ANTHROPIC_API_KEY  → https://console.anthropic.com/settings/keys
#   MISTRAL_API_KEY    → https://console.mistral.ai/api-keys
#   DEEPSEEK_API_KEY   → https://platform.deepseek.com/api_keys
#   TOGETHER_API_KEY   → https://api.together.xyz/settings/api-keys
# ----------------------------------------------------------
LLM_API_KEY=cole_sua_chave_aqui
# GROQ_API_KEY=cole_sua_chave_aqui

# ----------------------------------------------------------
# CONFIGURAÇÕES AVANÇADAS (opcionais)
# ----------------------------------------------------------

# URL base customizada (necessário com LLM_PROVIDER=custom)
# LLM_BASE_URL=https://meu-provedor.com/v1

# Temperatura (criatividade): 0.0 = determinístico, 2.0 = muito criativo (padrão: 0.3)
# LLM_TEMPERATURE=0.3

# Timeout em segundos para chamadas à LLM (padrão: 60)
# LLM_TIMEOUT=60

# Arquivo de instruções do agente (padrão: agents.md na mesma pasta)
# AGENTS_FILE=agents.md
