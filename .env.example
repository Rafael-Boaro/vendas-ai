# ============================================================
# Vendas + IA — configuração do provedor de LLM
# A chave de API é gerenciada pelo BACKEND (secrets.toml).
# Este arquivo .env pode ser usado em desenvolvimento local,
# mas em produção (Streamlit Cloud) use .streamlit/secrets.toml.
# ============================================================

# ----------------------------------------------------------
# PROVEDOR PRINCIPAL (opcional — padrão: groq)
# Opcoes: anthropic | openai | groq | gemini | openrouter | compativel
# ----------------------------------------------------------
LLM_PROVIDER=groq

# Ordem de fallback automatico (opcional, separados por virgula)
# LLM_FALLBACKS=gemini,openai,anthropic

# ----------------------------------------------------------
# CHAVES DE API (configure somente os provedores que usar)
# A interface NAO exibe campos de chave — elas ficam aqui.
# ----------------------------------------------------------
GROQ_API_KEY=cole_sua_chave_aqui
# ANTHROPIC_API_KEY=cole_sua_chave_aqui
# OPENAI_API_KEY=cole_sua_chave_aqui
# GEMINI_API_KEY=cole_sua_chave_aqui
# OPENROUTER_API_KEY=cole_sua_chave_aqui

# ----------------------------------------------------------
# MODELOS (opcional — usa o padrao do provedor se omitido)
# ----------------------------------------------------------
# GROQ_MODEL=openai/gpt-oss-120b
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_MODEL=gemini-2.5-flash
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Provedor compativel com OpenAI (Ollama / local)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3

# ----------------------------------------------------------
# CONFIGURACOES AVANCADAS (opcionais)
# ----------------------------------------------------------
# LLM_TEMPERATURE=0.3   # 0.0 = determinístico, 2.0 = muito criativo
# LLM_TIMEOUT=60        # timeout em segundos
# AGENTS_FILE=agents.md # arquivo de instrucoes do agente
