# Configuracao de Provedores LLM para o Streamlit — Vendas + IA
# Copie este arquivo para .streamlit/secrets.toml no ambiente local.
# No Streamlit Community Cloud, adicione estas linhas em Settings > Secrets.
# Preencha apenas os provedores que desejar utilizar.
# A chave de API NUNCA é inserida na interface: ela fica exclusivamente aqui.

# Provedor principal e ordem de fallback automatico (opcionais)
LLM_PROVIDER = "groq"
LLM_FALLBACKS = "gemini,openai,anthropic"

# 1. Anthropic (SDK nativo — claude-*)
ANTHROPIC_API_KEY = "sua-chave-anthropic-aqui"
ANTHROPIC_MODEL = "claude-3-5-sonnet-20241022"   # confirme na documentacao oficial

# 2. OpenAI (GPT)
OPENAI_API_KEY = "sua-chave-openai-aqui"
OPENAI_MODEL = "gpt-4o-mini"                     # confirme na documentacao oficial

# 3. Groq (API compativel com OpenAI)
GROQ_API_KEY = "sua-chave-groq-aqui"
GROQ_MODEL = "llama-3.3-70b-versatile"           # confirme na documentacao oficial

# 4. Google Gemini (Endpoint compativel com OpenAI)
GEMINI_API_KEY = "sua-chave-gemini-aqui"
GEMINI_MODEL = "gemini-2.5-flash"                # confirme na documentacao oficial

# 5. OpenRouter (API compativel com OpenAI)
OPENROUTER_API_KEY = "sua-chave-openrouter-aqui"
OPENROUTER_MODEL = "meta-llama/llama-3.3-70b-instruct"  # confirme na documentacao oficial

# 6. Provedor Generico compativel com OpenAI (ex: Ollama, vLLM local)
# LLM_BASE_URL = "http://localhost:11434/v1"
# LLM_API_KEY = "ollama"
# LLM_MODEL = "llama3"                           # confirme na documentacao oficial

# Configuracoes avancadas (opcionais)
# LLM_TEMPERATURE = "0.3"   # 0.0 = determinístico, 2.0 = muito criativo
# LLM_TIMEOUT = "60"        # timeout em segundos
